{
  "name": "adventurer-guild",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @guild/contracts build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @guild/api test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:seed": "pnpm --filter @guild/api db:seed",
    "dev": "pnpm --parallel --filter @guild/api --filter @guild/web dev",
    "start": "pnpm --filter @guild/api start"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
